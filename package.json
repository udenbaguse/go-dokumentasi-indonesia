{
  "name": "go-dokumentasi-indonesia",
  "displayName": "Go Dokumentasi Indonesia",
  "description": "hover-popup dokumentasi go dalam bahasa indonesia",
  "icon": "icon.ico",
  "version": "0.1.1",
  "publisher": "udenbaguse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/udenbaguse/go-dokumentasi-indonesia.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Education"
  ],
  "activationEvents": [
    "onLanguage:go"
  ],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "check": "node --check src/extension.js && node --check src/hoverProvider.js && node --check src/docsLoader.js",
    "test": "npm run check",
    "merge-docs": "node scripts/merge-docs.js",
    "compile": "npm run merge-docs && webpack --mode production",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "copy-webpack-plugin": "^12.0.0"
  }
}